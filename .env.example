# Copy sang .env rồi điền. .env đã được .gitignore.
#   cp .env.example .env

# Cổng server (mặc định 8787)
PORT=8787
HOST=0.0.0.0

# Mã bí mật cho trang /admin (bắt buộc đổi trước khi lên sự kiện)
ADMIN_TOKEN=doi-ma-nay-truoc-khi-su-dung

# Số người tối đa MỖI LƯỢT. Để trống = 5.
# Đặt riêng cho từng trò bằng MAX_PLAYERS_<TRÒ> (MATH | DRAW | MEMORY | SPOT | QUIZ),
# vì mỗi trò một sức chứa: Vẽ hình bắt máy chạy model cho từng người nên đông là
# chậm, còn Tính nhanh thì 10 người cùng lúc vẫn nhẹ.
# Nhận số nguyên 1-20; gõ sai thì server cảnh báo rồi dùng mặc định, không sập.
# Đây chỉ là giá trị KHỞI ĐẦU: giữa sự kiện BTC chỉnh thẳng ở /admin (nút - / +),
# và khởi động lại server thì quay về đúng con số ghi ở đây.
MAX_PLAYERS=5
# MAX_PLAYERS_DRAW=3
# MAX_PLAYERS_MATH=8

# Ai là triệu phú là trò cho CẢ KHÁN PHÒNG nên có sức chứa riêng: mặc định 50, tối đa 50,
# và KHÔNG theo MAX_PLAYERS ở trên (đó là con số cho các trò ở booth).
# MAX_PLAYERS_QUIZ=50

# Số người MỖI ĐỘI của Ai là triệu phú (2-10, mặc định 3). Server chia ngẫu nhiên khi BTC bấm
# Bắt đầu; BTC chỉnh tiếp được ở /admin, kể cả khi phòng chờ đã có người.
# QUIZ_TEAM_SIZE=3

# Nơi lưu bộ câu hỏi Ai là triệu phú do BTC import ở /admin (mặc định data/quiz-questions.json,
# nằm trong volume của Docker nên restart không mất). Chưa import gì thì dùng 40 câu có sẵn.
# QUIZ_BANK_FILE=data/quiz-questions.json

# Thư mục cache model ONNX
MODEL_CACHE_DIR=./models

# Đặt =1 để CHẶN mọi request tải model từ internet (chạy offline ngày sự kiện)
MODEL_OFFLINE=0

# Link Google Form đăng ký thành viên — hiện thành nút ở màn kết quả.
# Để RỖNG thì nút không hiện. Đổi link chỉ cần sửa đây rồi khởi động lại server,
# KHÔNG phải build lại web.
SIGNUP_FORM_URL=

# Mã ô "Họ tên" trong Form, dạng entry.123456789 — dùng để điền sẵn tên người chơi.
# Lấy bằng: mở Form -> dấu ba chấm -> Get pre-filled link -> điền thử tên -> Get link,
# rồi copy phần entry.xxxx trong URL nhận được. Để rỗng thì người chơi tự gõ tên.
SIGNUP_NAME_ENTRY=
